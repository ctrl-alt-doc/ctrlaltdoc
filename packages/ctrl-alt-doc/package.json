{
	"name": "ctrl-alt-doc",
	"version": "1.0.3",
	"license": "MIT",
	"description": "Documentation, without the baggage.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ctrl-alt-doc/ctrlaltdoc.git",
		"directory": "packages/ctrl-alt-doc"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"import": "./dist/server.js"
		},
		"./components": {
			"types": "./src/components.d.ts",
			"import": "./src/components.ts"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"import": "./dist/vite.js"
		},
		"./content": {
			"types": "./dist/content.d.ts",
			"import": "./dist/content.js"
		},
		"./styles/ctrlaltdoc.css": "./src/lib/styles/ctrlaltdoc.css"
	},
	"scripts": {
		"build": "tsc",
		"test": "pnpm build && node --test test/*.test.mjs"
	},
	"dependencies": {
		"@fontsource/outfit": "^5.3.0",
		"@hugeicons/core-free-icons": "^4.3.2",
		"@hugeicons/svelte": "^1.1.5",
		"gray-matter": "^4.0.3",
		"marked": "^18.0.11",
		"shiki": "^4.4.3",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@types/node": "^24.13.3"
	}
}
