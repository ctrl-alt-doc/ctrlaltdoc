{
	"name": "ctrlaltdoc-docs",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-28",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		}
	}
}
